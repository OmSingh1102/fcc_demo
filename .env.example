# ─────────────────────────────────────────────────────────────────────────────
# FinCrime KYC/KYB demo — deployment settings (template)
#
# On a server: copy this file to .env and edit the values. Do NOT keep a .env
# in a local working copy unless you want it to override the dev defaults and
# switch off the demo password hint.
#
# Loaded by load_dotenv() at the top of app.py, before anything reads the
# environment. Real environment variables win over this file. After changing
# anything here, RESTART the app — it is read once at import.
# ─────────────────────────────────────────────────────────────────────────────

# ── Session signing ──────────────────────────────────────────────────────────
# Flask signs the session cookie with this. It does not encrypt it. Anyone who
# knows the key can forge a cookie that says they are an L2 analyst without
# touching the login page, so the value hardcoded in app.py must not be the one
# a public host runs on. Changing it signs everyone out — nothing worse.
SECRET_KEY=change-me-to-a-long-random-string

# ── Sign-in ──────────────────────────────────────────────────────────────────
# The one password the sign-in card accepts for every analyst profile. Setting
# it stops the card printing the built-in demo password to every visitor and
# hides the "Switch user" shortcut unless DEMO_MODE below keeps it.
# STRAIVE_DEMO_PASSWORD=

# ── Demo affordances ─────────────────────────────────────────────────────────
# 1 keeps the Reset-demo button and the Switch-user shortcut visible even once a
# real password is set. Neither is a privilege path — they only reseed the
# fictional case book or move between the demo analysts. Set 0 to remove both.
DEMO_MODE=1

# ── Console case book ────────────────────────────────────────────────────────
# file (the default): the 1,000 cases of the reconciliation log the client
# sent (fincrime/filebook/data/kyc_wc_recon_log.csv), open at L1 Data Confirming.
# demo: the nineteen scripted scenarios and filler rows of the original
# walkthrough (the test suite runs on these). Switching clears the console's
# stored state.
# CONSOLE_CASES=file

# ── State ────────────────────────────────────────────────────────────────────
# Where the SQLite state store lives. Default: fincrime_state.db beside app.py.
# The test suite points this at a temp file before importing the app.
# FCC_STATE_DB=

# ── Server ───────────────────────────────────────────────────────────────────
# Leave DEBUG at 0 on anything reachable from outside — the Werkzeug debugger
# renders source and local variables to whoever triggers a traceback. DEBUG=1
# gives auto-reload while developing.
DEBUG=1
HOST=127.0.0.1
# 8010 so this demo can run beside ChargeShield (8000) on the same machine.
PORT=8010

# ── Model assessment (a real model, optional) ───────────────────────────────
# With a key set, every screening case gains an "AI assessment" button that
# asks Claude, through Straive's LLM Foundry gateway, whether the ticked
# alerts could be the client. Advisory only. Leave the key unset to run
# without it; the button then says why it is off. The console's AI Agent
# uses the same key to read the ID and proof-of-address images of the
# auto-verified cases, which then verify themselves (it starts on its own
# when the server starts).
# LLM_FOUNDRY_KEY=
# LLM_FOUNDRY_URL=https://llmfoundry.straivedemo.com
# The Claude model id; Opus 4.8 is the strongest this gateway enables.
# LLM_MODEL=claude-opus-4-8

# ── Uploaded document images and OCR ────────────────────────────────────────
# Real ID photos uploaded on a case are kept in uploads/ beside the state
# database (gitignored: they are real people's documents). Point elsewhere:
# FCC_UPLOAD_DIR=
# Tesseract, the OCR engine that reads the uploaded passport's MRZ on this
# machine as a cross-check beside Claude's read. Found on the PATH or in its
# usual Windows folders (C:\Program Files\Tesseract-OCR, or the per-user
# %LOCALAPPDATA%\Programs\Tesseract-OCR); set the full path to tesseract.exe
# here if it lives anywhere else. Without it OCR shows "not available" and
# blocks nothing.
# TESSERACT_CMD=
