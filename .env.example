# ─────────────────────────────────────────────────────────────────────────────
# FinCrime KYC/KYB demo — deployment settings (template)
#
# On a server: copy this file to .env and edit the values. Do NOT keep a .env
# in a local working copy unless you want it to override the dev defaults and
# switch off the demo password hint.
#
# Loaded by load_dotenv() at the top of app.py, before anything reads the
# environment. Real environment variables win over this file. After changing
# anything here, RESTART the app — it is read once at import.
# ─────────────────────────────────────────────────────────────────────────────

# ── Session signing ──────────────────────────────────────────────────────────
# Flask signs the session cookie with this. It does not encrypt it. Anyone who
# knows the key can forge a cookie that says they are an L2 analyst without
# touching the login page, so the value hardcoded in app.py must not be the one
# a public host runs on. Changing it signs everyone out — nothing worse.
SECRET_KEY=change-me-to-a-long-random-string

# ── Sign-in ──────────────────────────────────────────────────────────────────
# The one password the sign-in card accepts for every analyst profile. Setting
# it stops the card printing the built-in demo password to every visitor and
# hides the "Switch user" shortcut unless DEMO_MODE below keeps it.
# STRAIVE_DEMO_PASSWORD=

# ── Demo affordances ─────────────────────────────────────────────────────────
# 1 keeps the Reset-demo button and the Switch-user shortcut visible even once a
# real password is set. Neither is a privilege path — they only reseed the
# fictional case book or move between the demo analysts. Set 0 to remove both.
DEMO_MODE=1

# ── State ────────────────────────────────────────────────────────────────────
# Where the SQLite state store lives. Default: fincrime_state.db beside app.py.
# The test suite points this at a temp file before importing the app.
# FCC_STATE_DB=

# ── Server ───────────────────────────────────────────────────────────────────
# Leave DEBUG at 0 on anything reachable from outside — the Werkzeug debugger
# renders source and local variables to whoever triggers a traceback. DEBUG=1
# gives auto-reload while developing.
DEBUG=1
HOST=127.0.0.1
# 8010 so this demo can run beside ChargeShield (8000) on the same machine.
PORT=8010
