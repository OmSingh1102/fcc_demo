# Virtualenv — rebuildable from requirements.txt
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Runtime state the app writes and re-seeds on its own: every action an analyst
# takes on a case. The wildcard covers SQLite's -wal and -shm sidecars.
fincrime_state.db*
fincrime_screening.db*

# Deployment settings: session signing key, real passwords. The example file is
# the documented template and is the one exception, hence the negation.
.env
.env.*
!.env.example

# Frames of the real production tools that this demo is modelled on. They
# contain real people's identity documents and addresses. Never commit them.
docs/reference-screens/

# Document images uploaded in the console (fincrime/documents/uploads.py):
# customers' real passports, IDs and proofs of address. Never commit them.
uploads/

# Logs
server.log
*.stackdump

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Sanctions lists downloaded from their publishers (fincrime/sanctions.py): rebuilt by a download.
sanctions_lists/
